<div class="card mb-4">
  <div class="card-body">
    <h2 class="card-title"><%= "#{@owner.first_name} #{@owner.last_name}" %></h2>
    <p><strong>Email:</strong> <%= @owner.email %></p>
    <p><strong>Phone:</strong> <%= @owner.phone %></p>
    <p><strong>Address:</strong> <%= @owner.address %></p>
  </div>
</div>

<h3>Registered Pets</h3>
<ul class="list-group">
  <% @owner.pets.each do |pet| %>
    <li class="list-group-item">
      <%= link_to "#{pet.name} (#{pet.species} - #{pet.breed})", pet_path(pet) %>
    </li>
  <% end %>
</ul>
<br>

<div class="mt-4 d-flex gap-2">
  <%# Envolvemos el botón Edit %>
  <% if policy(@owner).update? %>
    <%= link_to 'Edit', edit_owner_path(@owner), class: "btn btn-warning" %>
  <% end %>

  <%# Envolvemos el botón Delete %>
  <% if policy(@owner).destroy? %>
    <%= button_to 'Delete', @owner, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
  <% end %>

  <%# El botón Back lo dejamos suelto porque todos pueden volver atrás %>
  <%= link_to 'Back to Owners', owners_path, class: "btn btn-secondary" %>
</div>